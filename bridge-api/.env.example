PORT=4100
NODE_ENV=development

# Optional: override config source
# CHAIN_GUARD_CONFIG_PATH=../chainguard-sentinel/config.json

# Required for real Gemini scans
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:3000

# CRE integration
CRE_WORKFLOW=chainguard-sentinel
CRE_TARGET=local-simulation
CRE_TIMEOUT_MS=120000
