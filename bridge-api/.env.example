# Environment Configuration
NODE_ENV=development
PORT=3001

# CRE Configuration
CRE_WORKFLOW_PATH=../chainguard-sentinel
CRE_TARGET=local-simulation

# Chainlink
CHAINLINK_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/demo

# API Keys (optional for simulation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp
SLACK_WEBHOOK=

# Security
ENABLE_AUTH=false
JWT_SECRET=dev-secret-change-in-production

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=info

# Database (future)
DB_ENABLED=false
DATABASE_URL=

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:3000

# CRE integration
CRE_WORKFLOW=chainguard-sentinel
CRE_TARGET=local-simulation
CRE_TIMEOUT_MS=120000
